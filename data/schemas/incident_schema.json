{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Safety Incident",
  "type": "object",
  "required": [
    "incident_id",
    "timestamp",
    "severity"
  ],
  "properties": {
    "incident_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "severity": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  }
}
